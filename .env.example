# ==============================================================================
# PreSend Environment Configuration
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase / PostgreSQL Configuration (Persistent Database Layer)
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE Key (Secret)
# Found in Supabase Project Settings -> API -> Project API Keys -> service_role
# SECURITY CAUTION: This key bypasses Row Level Security (RLS) for server-side
# operations. NEVER expose this key in client-side bundles or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# LLM Providers (Explainability Layer)
# ------------------------------------------------------------------------------
# Primary model provider: Anthropic Claude (claude-sonnet-4-5)
ANTHROPIC_API_KEY=

# Secondary fallback provider: Google Gemini (gemini-2.0-flash)
# Also supports GOOGLE_API_KEY
GEMINI_API_KEY=
